# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored. Never commit real credentials.

# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: override the local data directory used for brand memory, content
# history, A/B plans, competitor records, seasonal plans, and scheduler state.
# Defaults to ./data relative to the project root.
#TEA_DATA_DIR=./data
