# ---- LLM ----
# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-4-7
# MKT101_MODEL=claude-opus-4-7

# Optional. Cap on output tokens per LLM call
# MKT101_MAX_OUTPUT_TOKENS=32000

# ---- Storage paths ----
# Both default to the project's data/ folder. Override if you keep data elsewhere.
# MKT101_DATA_DIR=./data
# MKT101_LOG_DIR=./data/logs

# ---- Meta Graph API (Facebook + Instagram Business) ----
# Generate a long-lived page or system-user token with the permissions listed
# in connectors/meta_graph.py. Leave empty to disable the Meta tab.
META_ACCESS_TOKEN=
META_FB_PAGE_ID=
META_IG_USER_ID=
# Default: v21.0
# META_GRAPH_VERSION=v21.0

# ---- Crawler ----
# Identify yourself. Change the contact slug for the brand team.
# CRAWLER_USER_AGENT=mkt101-tea-brand-crawler/1.0 (+contact-your-team)
# CRAWLER_RATE_LIMIT_SECONDS=1.0
# CRAWLER_MAX_PAGES=80
# CRAWLER_REQUEST_TIMEOUT=15

# ---- Safety flags ----
# Default: false. Keep this off in v2 — posting stays approval-first.
# ALLOW_AUTOPOST=false
